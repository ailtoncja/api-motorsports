# API (npm run dev / Vercel) -- so leitura
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# NASCAR Brasil e Porsche Cup Brasil: ja sincronizadas pelo motor do
# pitstophub-data, que grava no Supabase do PitStopHub (outro projeto). A API
# so le essas tabelas -- sem estas duas vars, as rotas delas respondem 503 e o
# resto da API continua normal.
PITSTOPHUB_SUPABASE_URL=https://YOUR_PITSTOPHUB_REF.supabase.co
PITSTOPHUB_SUPABASE_ANON_KEY=YOUR_PITSTOPHUB_ANON_KEY

# NUNCA coloque a service_role key aqui nem na Vercel: quem escreve no banco
# sao as Edge Functions (supabase/functions), que recebem a key do Supabase.
